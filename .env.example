# PrepTracker environment
#
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

# --- Required ---------------------------------------------------------------

# Postgres connection string.
#   Local development (docker-compose.dev.yml runs Postgres on 5433):
DATABASE_URL="postgresql://preptracker:preptracker@localhost:5433/preptracker?schema=public"
#   Inside docker-compose.yml the app reaches the database as host "db":
#   DATABASE_URL="postgresql://preptracker:CHANGE_ME@db:5432/preptracker?schema=public"

# Signs the session cookie. At least 32 characters, and actually random: the
# app refuses to start on the placeholder below, or on anything with too few
# distinct characters, because a guessable secret lets anyone mint a session.
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Docker Compose ---------------------------------------------------------

# Used by docker-compose.yml to create the database and build DATABASE_URL.
POSTGRES_USER="preptracker"
POSTGRES_PASSWORD="change-me-too"
POSTGRES_DB="preptracker"

# Where the app listens on the host.
#   127.0.0.1 -> reachable only from the machine running Docker (default).
#   0.0.0.0   -> reachable from your LAN. Only do this on a network you trust.
APP_BIND="127.0.0.1"
APP_PORT="3000"

# --- First run --------------------------------------------------------------

# The account created by the seed. If ADMIN_PASSWORD is left empty the password
# is "preptracker" and the app will prompt you to change it on first sign-in.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- Behaviour --------------------------------------------------------------

# Your timezone, so "today" flips at your midnight rather than UTC's.
#   Examples: Europe/London, America/New_York, Africa/Lagos, Australia/Sydney
TZ="UTC"

# Set to "true" only when the app is served over HTTPS. Leaving it false lets
# the session cookie work over plain HTTP on a LAN or Tailscale address.
COOKIE_SECURE="false"

# --- Development (optional) -------------------------------------------------

# Extra hosts allowed to load `next dev` resources, comma separated. Needed when
# you open the dev server from another device. Tailscale (*.ts.net and 100.x),
# *.local and private LAN ranges are already allowed.
#   DEV_ORIGINS="my-laptop.tail1234.ts.net,100.95.116.73"

# --- Tests (optional) -------------------------------------------------------

# Integration tests create and use their own database. Defaults to the
# DATABASE_URL host with the database name "preptracker_test".
# TEST_DATABASE_URL="postgresql://preptracker:preptracker@localhost:5433/preptracker_test?schema=public"

# --- Backups ----------------------------------------------------------------

# All of these have defaults, so the nightly dump works without setting any of
# them. The off-host copy is the exception: it does nothing until you point it
# somewhere. A backup on the same disk as the database is not a backup.
# Full detail in docs/DEPLOYMENT.md, under Backups.

# When the nightly dump runs, and which weekday (1 = Monday) gets the weekly
# restore check and off-host copy.
# BACKUP_TIME="03:15"
# BACKUP_WEEKLY_DAY="7"
# BACKUP_RETENTION_DAYS="30"

# Where the weekly copy goes. Set one, or both.
#   A second disk or NAS mount, also uncommented in docker-compose.yml:
# BACKUP_SECONDARY_DIR="/backups-secondary"
#   Another machine on your tailnet:
# BACKUP_RSYNC_TARGET="user@host:/srv/preptracker-backups"
# BACKUP_SSH_KEY_FILE="./secrets/backup_ssh_key"

# The age public key the off-host copy is encrypted to. Generate a key pair with
#   age-keygen -o backup-key.txt
# and keep the private half in your password manager — without it the copies are
# unreadable, including by you. Copying in the clear needs an explicit opt-in.
# BACKUP_AGE_RECIPIENT="age1..."
# BACKUP_ALLOW_UNENCRYPTED="0"

# --- Upgrades ---------------------------------------------------------------

# Which image tag docker-compose.yml runs. Set it to a released version so the
# running build is traceable to a commit.
# PREPTRACKER_TAG="latest"

# Migrations refuse to run against a database with data when the newest dump is
# older than this, because "back up first" should be enforced rather than
# remembered. Override for one run with SKIP_BACKUP_GATE=1.
# BACKUP_MAX_AGE_HOURS="48"
