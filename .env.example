# PrepTracker environment
#
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

# --- Required ---------------------------------------------------------------

# Postgres connection string.
#   Local development (docker-compose.dev.yml runs Postgres on 5433):
DATABASE_URL="postgresql://preptracker:preptracker@localhost:5433/preptracker?schema=public"
#   Inside docker-compose.yml the app reaches the database as host "db":
#   DATABASE_URL="postgresql://preptracker:CHANGE_ME@db:5432/preptracker?schema=public"

# Signs the session cookie. At least 32 characters.
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Docker Compose ---------------------------------------------------------

# Used by docker-compose.yml to create the database and build DATABASE_URL.
POSTGRES_USER="preptracker"
POSTGRES_PASSWORD="change-me-too"
POSTGRES_DB="preptracker"

# Where the app listens on the host.
#   127.0.0.1 -> reachable only from the machine running Docker (default).
#   0.0.0.0   -> reachable from your LAN. Only do this on a network you trust.
APP_BIND="127.0.0.1"
APP_PORT="3000"

# --- First run --------------------------------------------------------------

# The account created by the seed. If ADMIN_PASSWORD is left empty the password
# is "preptracker" and the app will prompt you to change it on first sign-in.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- Behaviour --------------------------------------------------------------

# Your timezone, so "today" flips at your midnight rather than UTC's.
#   Examples: Europe/London, America/New_York, Africa/Lagos, Australia/Sydney
TZ="UTC"

# Set to "true" only when the app is served over HTTPS. Leaving it false lets
# the session cookie work over plain HTTP on a LAN or Tailscale address.
COOKIE_SECURE="false"

# --- Development (optional) -------------------------------------------------

# Extra hosts allowed to load `next dev` resources, comma separated. Needed when
# you open the dev server from another device. Tailscale (*.ts.net and 100.x),
# *.local and private LAN ranges are already allowed.
#   DEV_ORIGINS="my-laptop.tail1234.ts.net,100.95.116.73"

# --- Tests (optional) -------------------------------------------------------

# Integration tests create and use their own database. Defaults to the
# DATABASE_URL host with the database name "preptracker_test".
# TEST_DATABASE_URL="postgresql://preptracker:preptracker@localhost:5433/preptracker_test?schema=public"
